<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteControlService: performs touches (gestures) and types into the focused field, for
     whoever is connected with rdesk while access to this phone is on. It reads no events. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/touch_control_description"
    android:summary="@string/touch_control_summary"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="1000"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"/>

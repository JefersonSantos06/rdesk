# /etc/systemd/system/rdesk-server.service — see docs/SERVER.md
#   sudo useradd --system --home-dir /var/lib/rdesk-server --create-home rdesk
#   sudo -u rdesk rdesk-server init --public-url https://rdesk.example.com --admin you@gmail.com
[Unit]
Description=rdesk server
After=network-online.target
Wants=network-online.target

[Service]
User=rdesk
ExecStart=/usr/local/bin/rdesk-server run
Restart=always
RestartSec=3
Environment=RDESK_SERVER_DATA=/var/lib/rdesk-server
# Port 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rdesk-server
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
